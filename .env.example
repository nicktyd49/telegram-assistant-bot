TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
ALLOWED_USER_ID=
ANTHROPIC_MODEL=claude-sonnet-5

# Timezone used to interpret "today", "3pm", etc. and to timestamp receipts.
TIMEZONE=Asia/Singapore
DEFAULT_CURRENCY=SGD
AGENT_NAME=Nicholas
EXTRACTION_MODEL=claude-haiku-4-5-20251001

# --- Google Calendar + Sheets (service account) ---
# Paste the FULL contents of the service account JSON key as one line here.
# (Alternative for local dev: set GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/key.json instead.)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=

# The calendar to read/write. Usually just your Gmail address, or a calendar ID
# from that calendar's Settings > "Integrate calendar" page.
GOOGLE_CALENDAR_ID=

# The spreadsheet to log receipts into — the long ID in its URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
GOOGLE_SHEET_ID=

# Folder to archive original policy PDFs into (one subfolder per client),
# e.g. a path inside a OneDrive-synced folder so they're backed up and
# retrievable later. Leave blank to skip archiving.
POLICY_PDF_STORAGE_DIR=
